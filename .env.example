# Optional Telegram notification channel
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# CRM sync (use the same Supabase project as the Trade Firm CRM)
# Keep the service-role key server-side in Vercel. Never prefix it with NEXT_PUBLIC_.
CRM_SUPABASE_URL=https://your-project.supabase.co
CRM_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
